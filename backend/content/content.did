type VideoSubmission = 
 record {
   citation: text;
   clipUrl: text;
   createdAt: int;
   id: text;
   linkedPlayId: opt text;
   reviewedAt: opt int;
   status: SubmissionStatus;
   submitter: principal;
 };
type SubmissionStatus = 
 variant {
   Approved;
   Pending;
   Rejected;
 };
type SportLevel = 
 record {
   displayName: text;
   id: text;
 };
type SportInput = 
 record {
   displayName: text;
   id: text;
   levels: vec SportLevel;
   rulebookYear: text;
 };
type Sport = 
 record {
   displayName: text;
   id: text;
   levels: vec SportLevel;
   rulebookYear: text;
 };
type ScenarioInput = 
 record {
   crewSize: nat;
   description: text;
   players: vec DiagramPlayer;
   title: text;
   zones: vec MechanicsZone;
 };
type RuleChangeInput = 
 record {
   articleId: text;
   citation: text;
   newText: text;
   oldText: text;
   season: text;
   source: text;
   sportId: text;
   summary: text;
   title: text;
 };
type RuleChangeError = 
 variant {
   invalid: text;
   notAdmin;
   notFound;
 };
type RuleChange = 
 record {
   articleId: text;
   citation: text;
   createdAt: int;
   id: text;
   newText: text;
   oldText: text;
   season: text;
   source: text;
   sportId: text;
   summary: text;
   title: text;
   updatedAt: int;
 };
type Result_9 = 
 variant {
   err: text;
   ok: vec VideoSubmission;
 };
type Result_8 = 
 variant {
   err: text;
   ok: ImportResult;
 };
type Result_7 = 
 variant {
   err: text;
   ok;
 };
type Result_6 = 
 variant {
   err: text;
   ok: VideoSubmission;
 };
type Result_5 = 
 variant {
   err: text;
   ok: Article;
 };
type Result_4 = 
 variant {
   err: text;
   ok: MechanicsScenario;
 };
type Result_3 = 
 variant {
   err: text;
   ok: CasebookPlay;
 };
type Result_2 = 
 variant {
   err: text;
   ok: PointOfEmphasis;
 };
type Result_10 = 
 variant {
   err: RuleChangeError;
   ok;
 };
type Result_1 = 
 variant {
   err: RuleChangeError;
   ok: RuleChange;
 };
type Result = 
 variant {
   err: text;
   ok: Sport;
 };
type PointOfEmphasis = 
 record {
   audioUrl: opt text;
   body: text;
   createdAt: int;
   id: PoeId;
   linkedArticleIds: vec text;
   season: text;
   title: text;
 };
type PoeInput = 
 record {
   body: text;
   linkedArticleIds: vec text;
   season: text;
   title: text;
 };
type PoeId = text;
type PlayInput = 
 record {
   articleId: ArticleId;
   citation: text;
   diagram: opt CourtDiagram;
   ruling: text;
   scenario: text;
 };
type MechanicsZone = 
 record {
   correctOfficial: text;
   height: nat;
   id: text;
   width: nat;
   x: nat;
   y: nat;
 };
type MechanicsScenario = 
 record {
   createdAt: int;
   crewSize: nat;
   description: text;
   id: text;
   players: vec DiagramPlayer;
   title: text;
   zones: vec MechanicsZone;
 };
type ImportResult = 
 record {
   added: nat;
   removed: nat;
   updated: nat;
 };
type DiagramPlayer = 
 record {
   id: text;
   role: text;
   shortLabel: text;
   x: nat;
   y: nat;
 };
type DiagramArrow = 
 record {
   fromId: text;
   style: text;
   toId: text;
 };
type CourtDiagram = 
 record {
   arrows: vec DiagramArrow;
   players: vec DiagramPlayer;
 };
type CasebookPlay = 
 record {
   articleId: ArticleId;
   audioUrl: opt text;
   citation: text;
   diagram: opt CourtDiagram;
   id: text;
   ruling: text;
   scenario: text;
   videoUrl: opt text;
 };
type ArticleInput = 
 record {
   body: text;
   language: text;
   levelId: text;
   number: nat;
   sportId: text;
   title: text;
 };
type ArticleId = text;
type Article = 
 record {
   audioUrl: opt text;
   body: text;
   createdAt: int;
   id: ArticleId;
   language: text;
   levelId: text;
   number: nat;
   sportId: text;
   title: text;
   updatedAt: int;
 };
service : {
  approveSubmission: (id: text, playId: text) -> (Result_6);
  deleteRuleChange: (id: text) -> (Result_10);
  /// Called by the user canister when an official deletes their account:
  /// deletes their clip submissions that weren't used. An approved clip is
  /// already part of a casebook play, so it stays, with the submitter
  /// replaced by the anonymous principal. Safe to repeat.
  forgetUser: (p: principal) -> (Result_7);
  getArticle: (id: ArticleId) -> (opt Article) query;
  getArticleAudio: (id: ArticleId) -> (opt blob) query;
  getMechanicsScenario: (id: text) -> (opt MechanicsScenario) query;
  getMySubmissions: () -> (vec VideoSubmission) query;
  isAdminCaller: () -> (bool) query;
  listArticles: (sportId: text, levelId: text, language: text) ->
   (vec Article) query;
  listMechanicsScenarios: () -> (vec MechanicsScenario) query;
  listPendingSubmissions: () -> (Result_9) query;
  listPlays: (articleId: ArticleId) -> (vec CasebookPlay) query;
  /// The plays of several articles in one call (offline sync used to make
  /// one listPlays call per article).
  listPlaysFor: (articleIds: vec ArticleId) -> (vec CasebookPlay) query;
  listPointsOfEmphasis: (season: text) -> (vec PointOfEmphasis) query;
  /// A sport's rule changes for a season (e.g. "2026-27"), oldest first.
  listRuleChanges: (sportId: text, season: text) -> (vec RuleChange) query;
  /// A sport's points of emphasis for a season, oldest first (those
  /// imported for it with replacePointsOfEmphasis).
  listSportPointsOfEmphasis: (sportId: text, season: text) ->
   (vec PointOfEmphasis) query;
  listSports: () -> (vec Sport) query;
  metrics: () -> (record {
                    articleCount: nat;
                    playCount: nat;
                  }) query;
  rejectSubmission: (id: text) -> (Result_6);
  /// Replaces an article's approved rulings with `items` (a rulebook
  /// import). A play whose citation is in `items` keeps its id, audio and
  /// video and takes the new wording; the article's other plays are
  /// removed. Running the same import twice changes nothing. Admin only.
  replacePlays: (articleId: ArticleId, items: vec PlayInput) -> (Result_8);
  /// Replaces a sport's points of emphasis for a season with `items` (a
  /// rulebook import), matching by title: a match keeps its id and audio
  /// and takes the new wording; the sport's others for the season are
  /// removed. Admin only.
  replacePointsOfEmphasis: (sportId: text, season: text, items:
   vec PoeInput) -> (Result_8);
  setAdmin: (p: principal) -> (Result_7);
  setArticleAudio: (id: ArticleId, audio: blob) -> (Result_7);
  setPlayVideo: (id: text, url: text) -> (Result_3);
  setPoeAudio: (id: PoeId, audio: blob) -> (Result_7);
  submitVideoClip: (citation: text, clipUrl: text) -> (Result_6);
  upsertArticle: (input: ArticleInput) -> (Result_5);
  upsertMechanicsScenario: (input: ScenarioInput) -> (Result_4);
  upsertPlay: (input: PlayInput) -> (Result_3);
  upsertPointOfEmphasis: (input: PoeInput) -> (Result_2);
  /// Adds a change (id null) or replaces the one with `id`. Admin only.
  upsertRuleChange: (id: opt text, input: RuleChangeInput) -> (Result_1);
  upsertSport: (input: SportInput) -> (Result);
}
