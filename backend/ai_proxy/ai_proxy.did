type Result_4 = 
 variant {
   err: text;
   ok: record {
         limitPerDay: nat;
         usedToday: nat;
       };
 };
type Result_3 = 
 variant {
   err: text;
   ok: blob;
 };
type Result_2 = 
 variant {
   err: text;
   ok: vec record {
             text;
             text;
           };
 };
type Result_1 = 
 variant {
   err: text;
   ok;
 };
type Result = 
 variant {
   err: text;
   ok: text;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type Access = 
 variant {
   free;
   paywallOff;
   pro;
 };
service : {
  askRuleAssistant: (question: text, context: text) -> (Result);
  /// Called by the user canister when an official deletes their account:
  /// drops their daily usage counter. Safe to repeat.
  forgetUser: (p: principal) -> (Result_1);
  generatePersonalizedDrills: (weakAreasContext: text, count: nat) ->
   (Result);
  generateScenarios: (instructions: text, articleContext: text, count:
   nat) -> (Result);
  getGlobalUsage: () -> (Result_4) query;
  /// The caller's AI usage today and their cap, by tier (issue #71).
  getMyAiUsage: () ->
   (record {
      access: Access;
      limitPerDay: nat;
      resetAt: int;
      used: nat;
    }) composite_query;
  /// Older clients' status call. A plain query can't ask the user canister,
  /// so the cap is the one from the caller's last request; the app uses
  /// getMyAiUsage instead.
  getMyRateLimitStatus: () ->
   (record {
      limitPerDay: nat;
      resetAt: int;
      used: nat;
    }) query;
  httpPost: (url: text, headers: vec HttpHeader, bodyJson: text, maxBytes:
   nat64) -> (Result_3);
  isAdminCaller: () -> (bool) query;
  isConfigured: () -> (bool) query;
  listPromptTemplates: () -> (Result_2) query;
  metrics: () -> (record {
                    aiConfigured: bool;
                    ok: bool;
                  }) query;
  setAdmin: (p: principal) -> (Result_1);
  setAnthropicKey: (key: text) -> (Result_1);
  setClaudeModel: (model: text) -> (Result_1);
  setGlobalDailyLimit: (limit: nat) -> (Result_1);
  setPromptTemplate: (name: text, content: text) -> (Result_1);
  suggestRuleForCall: (note: text, candidates: text) -> (Result);
}
