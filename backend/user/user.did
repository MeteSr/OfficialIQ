type WeeklySchedule = 
 record {
   dueThisWeek: vec text;
   overdue: vec text;
   weekNumber: nat;
 };
type WeeklyQuizResult = 
 record {
   completedAt: int;
   newScore: nat;
   retentionScore: nat;
   weekNumber: nat;
 };
type UpcomingGameInput = 
 record {
   gameDate: int;
   hasStartTime: opt bool;
   levelId: text;
   notes: text;
   opponent: text;
   sportId: text;
 };
type UpcomingGame = 
 record {
   createdAt: int;
   gameDate: int;
   id: text;
   levelId: text;
   notes: text;
   opponent: text;
   sportId: text;
 };
type TrainingActivity = 
 record {
   monthlyQuizzes: vec MonthlyQuizResult;
   studyDays: vec StudyDay;
   weeklyQuizzes: vec WeeklyQuizResult;
 };
type TrainingAccessError = 
 variant {
   licenseRequired;
   notAuthorized;
 };
type StudyPace = 
 record {
   articlesPerWeek: nat;
   startDate: int;
 };
type StudyDay = 
 record {
   day: nat;
   seconds: nat;
 };
type SiblingError = variant {notSibling;};
type Role = 
 variant {
   Admin;
   Assessor;
   Coordinator;
   Official;
 };
type Result_9 = 
 variant {
   err: SiblingError;
   ok: bool;
 };
type Result_8 = 
 variant {
   err: text;
   ok: vec ClientError;
 };
type Result_7 = 
 variant {
   err: CallLogError;
   ok: CallLogEntry;
 };
type Result_6 = 
 variant {
   err: CertGoalError;
   ok: opt CertGoal;
 };
type Result_5 = 
 variant {
   err: PaywallError;
   ok;
 };
type Result_4 = 
 variant {
   err: AdminError;
   ok;
 };
type Result_3 = 
 variant {
   err: text;
   ok: StudyPace;
 };
type Result_2 = 
 variant {
   err: SiblingError;
   ok;
 };
type Result_16 = 
 variant {
   err: SiblingError;
   ok: Access;
 };
type Result_15 = 
 variant {
   err: text;
   ok: UpcomingGame;
 };
type Result_14 = 
 variant {
   err: ClaimError;
   ok: MyEntitlement;
 };
type Result_13 = 
 variant {
   err: CallLogError;
   ok;
 };
type Result_12 = 
 variant {
   err: TrainingAccessError;
   ok: TrainingActivity;
 };
type Result_11 = 
 variant {
   err: text;
   ok: vec GameDayPush;
 };
type Result_10 = 
 variant {
   err: text;
   ok: opt PushSubscription;
 };
type Result_1 = 
 variant {
   err: text;
   ok;
 };
type Result = 
 variant {
   err: text;
   ok: Profile;
 };
type PushSubscription = 
 variant {
   Native: record {
             platform: text;
             token: text;
           };
   WebPush: record {
              auth: text;
              endpoint: text;
              p256dh: text;
            };
 };
type PublicProfile = 
 record {
   displayName: text;
   level: text;
   "principal": principal;
   sport: text;
   state: text;
 };
type ProfileUpdate = 
 record {
   displayName: text;
   level: text;
   preferredLanguage: text;
   sport: text;
   state: text;
 };
type Profile = 
 record {
   createdAt: int;
   displayName: text;
   level: text;
   preferredLanguage: text;
   "principal": principal;
   role: Role;
   sport: text;
   state: text;
 };
type PaywallError = 
 variant {
   examNotUpdated;
   notAdmin;
 };
type MyEntitlement = 
 record {
   entitlements: vec Entitlement;
   paywallEnabled: bool;
   tier: variant {
           free;
           pro;
         };
 };
type MonthlyQuizResult = 
 record {
   articleScores: vec record {
                        text;
                        nat;
                      };
   completedAt: int;
   month: nat;
   score: nat;
 };
type LinkedAccount = 
 record {
   externalId: text;
   linkedAt: int;
   provider: text;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type GameDayPush = 
 record {
   game: UpcomingGame;
   official: principal;
 };
type EntitlementSource = 
 variant {
   appStore;
   association: text;
   comp;
   playStore;
   web: text;
 };
type Entitlement = 
 record {
   expiresAt: int;
   source: EntitlementSource;
   tier: variant {pro;};
   updatedAt: int;
 };
type DeletionStatus = 
 variant {
   InProgress: record {remaining: nat;};
   NotRequested;
 };
type ClientErrorInput = 
 record {
   kind: text;
   message: text;
   platform: text;
   release: text;
   route: text;
   stack: text;
 };
type ClientError = 
 record {
   at: int;
   kind: text;
   message: text;
   platform: text;
   release: text;
   route: text;
   seq: nat;
   signedIn: bool;
   stack: text;
 };
type ClaimError = 
 variant {
   alreadyClaimed;
   invalidSession;
   malformed;
   notActive;
   notComplete;
   notConfigured;
   notSignedIn;
   notSubscription;
   notYours;
   stripeUnavailable;
 };
type CertGoalInput = 
 record {
   examDate: int;
   templateId: opt text;
 };
type CertGoalError = 
 variant {
   inPast;
   invalidTemplate;
   notSignedIn;
   tooFar;
 };
type CertGoal = 
 record {
   examDate: int;
   templateId: opt text;
   updatedAt: int;
 };
type CallStatus = 
 variant {
   open;
   queued;
   reviewed;
 };
type CallMatch = 
 record {
   articleId: text;
   citation: text;
   playId: opt text;
 };
type CallLogError = 
 variant {
   emptyNote;
   gameNotFound;
   gameNotPlayed;
   gameTooOld;
   invalidMatch;
   notFound;
   notSignedIn;
   noteTooLong;
   tooMany;
 };
type CallLogEntry = 
 record {
   createdAt: int;
   gameId: text;
   id: text;
   match: opt CallMatch;
   note: text;
   status: CallStatus;
   updatedAt: int;
 };
type ArticleProgress = 
 record {
   articleId: text;
   lastStudied: int;
   masteryScore: nat;
   timesStudied: nat;
 };
type AdminError = variant {notAdmin;};
type Access = 
 variant {
   free;
   paywallOff;
   pro;
 };
service : {
  /// For sibling canisters (ai_proxy, exam, and later #63/#65): what `p`
  /// gets. #paywallOff while billing is switched off.
  accessFor: (p: principal) -> (Result_16) query;
  ackGameDayPush: (gameId: text) -> (Result_1);
  addCallLog: (gameId: text, note: text) -> (Result_7);
  addUpcomingGame: (input: UpcomingGameInput) -> (Result_15);
  becomeCoordinator: () -> (Result);
  /// Grants Pro from a finished Stripe Checkout: the session must name the
  /// caller as its client_reference_id, be complete, and have started a
  /// subscription that is active or trialing.
  claimWebSubscription: (sessionId: text) -> (Result_14);
  createProfile: (req: ProfileUpdate) -> (Result);
  deleteAccount: () -> (Result_1);
  deleteCallLog: (id: text) -> (Result_13);
  getDeletionStatus: () -> (DeletionStatus) query;
  /// A member's training activity, for the coordinator of an association
  /// they belong to. Once the paywall is on, that association needs a
  /// seat license (issue #78); one that lapsed keeps reading what's there.
  getMemberTrainingActivity: (p: principal) -> (Result_12) composite_query;
  getMonthlyQuizHistory: () -> (vec MonthlyQuizResult) query;
  getMyCallLogs: () -> (vec CallLogEntry) query;
  getMyCertGoal: () -> (opt CertGoal) query;
  getMyEntitlement: () -> (MyEntitlement) query;
  getMyLinkedAccounts: () -> (vec LinkedAccount) query;
  getMyProfile: () -> (opt Profile) query;
  getMyProgress: () -> (vec ArticleProgress) query;
  getMyPushSubscription: () -> (opt PushSubscription) query;
  /// The caller's games from the last 30 days that have started, newest
  /// first: the ones calls can be logged against.
  getMyRecentGames: () -> (vec UpcomingGame) query;
  /// Calls with an accepted rule that haven't been reviewed yet.
  getMyReviewQueue: () -> (vec CallLogEntry) query;
  getMyStudyPace: () -> (opt StudyPace) query;
  getMyTrainingActivity: () -> (TrainingActivity) query;
  getMyUpcomingGames: () -> (vec UpcomingGame) query;
  /// Games starting within the next two hours whose official has push set up
  /// and hasn't been pushed for them yet. Push relay or admin only.
  getPendingGameDayPushes: () -> (Result_11) query;
  getProfile: (p: principal) -> (opt Profile) query;
  getPublicProfile: (p: principal) -> (opt PublicProfile) query;
  getSubscriptionFor: (p: principal) -> (Result_10) query;
  getWeeklyQuizHistory: () -> (vec WeeklyQuizResult) query;
  getWeeklySchedule: (allArticleIds: vec text) -> (WeeklySchedule) query;
  /// Pro for support cases, reviewers and the App Store review account,
  /// until `until` (nanoseconds). Replaces an earlier comp.
  grantComp: (p: principal, until: int) -> (Result_4);
  isAdminCaller: () -> (bool) query;
  isCoordinator: (p: principal) -> (bool) query;
  /// For sibling canisters: whether `p` gets Pro features. True for
  /// everyone while the paywall is off.
  isPro: (p: principal) -> (Result_9) query;
  linkExternalAccount: (provider: text, externalId: text) -> (Result_1);
  /// Newest first, at most `limit`.
  listClientErrors: (limit: nat) -> (Result_8) query;
  logClientError: (e: ClientErrorInput) -> ();
  markCallReviewed: (id: text) -> (Result_7);
  metrics: () ->
   (record {
      clientErrors: nat;
      completedDeletions: nat;
      paywallEnabled: bool;
      pendingDeletions: nat;
      proBySource: vec record {
                         text;
                         nat;
                       };
      userCount: nat;
    }) query;
  recordArticleStudied: (articleId: text, score: nat) -> ();
  /// Called by the exam canister when a quiz or exam finishes: each article
  /// in it counts as studied, scored by its accuracy in that session. Safe
  /// to repeat.
  recordGradedStudy: (player: principal, sessionId: text, articleScores:
   vec record {
         text;
         nat;
       }) -> (Result_1);
  recordMonthlyQuizResult: (month: nat, score: nat, articleScores:
   vec record {
         text;
         nat;
       }) -> ();
  recordStudyBeat: () -> ();
  recordWeeklyQuizResult: (weekNumber: nat, newScore: nat, retentionScore:
   nat) -> ();
  registerPushSubscription: (sub: PushSubscription) -> (Result_1);
  removeUpcomingGame: (id: text) -> (Result_1);
  revokeComp: (p: principal) -> (Result_4);
  setAdmin: (p: principal) -> (Result_1);
  /// Accepts (or changes) the rule for a call, which queues it for review.
  setCallMatch: (id: text, m: CallMatch) -> (Result_7);
  /// Sets the caller's exam date (and template), or clears it with null.
  setCertGoal: (input: opt CertGoalInput) -> (Result_6);
  /// Switches billing on or off and tells the canisters that keep a copy.
  /// If one can't be told, the switch still changes here and the call
  /// reports #examNotUpdated (any copy, not only exam's), so try again.
  setPaywallEnabled: (on: bool) -> (Result_5);
  setPushRelay: (p: opt principal) -> (Result_1);
  setRole: (p: principal, role: Role) -> (Result);
  setStripeKey: (key: opt text) -> (Result_4);
  setStudyPace: (articlesPerWeek: nat) -> (Result_3);
  /// From the association canister only: `holders` hold the association's
  /// seats until `expiresAt`. Anyone it listed before and not now loses
  /// that entitlement. Safe to repeat.
  syncAssociationSeats: (associationId: text, holders: vec principal,
   expiresAt: int) -> (Result_2);
  transformStripe: (record {
                      context: blob;
                      response: HttpRequestResult;
                    }) -> (HttpRequestResult) query;
  unlinkExternalAccount: (provider: text) -> (Result_1);
  unregisterPushSubscription: () -> (Result_1);
  updateProfile: (req: ProfileUpdate) -> (Result);
}
