type WeakArticlesError = variant {proOnly;};
type UserQuestionHistory = 
 record {
   easiness: float64;
   intervalDays: nat;
   lastAnswered: int;
   nextDue: int;
   questionId: text;
   repetitions: nat;
   timesAnswered: nat;
   timesCorrect: nat;
 };
type TagError = 
 variant {
   notAdmin;
   notFound;
   tooMany;
 };
type Result_6 = 
 variant {
   err: text;
   ok: Question;
 };
type Result_5 = 
 variant {
   err: WeakArticlesError;
   ok: vec record {
             text;
             nat;
             nat;
           };
 };
type Result_4 = 
 variant {
   err: text;
   ok: vec QuestionReport;
 };
type Result_3 = 
 variant {
   err: text;
   ok: vec Question;
 };
type Result_2 = 
 variant {
   err: text;
   ok: QuestionReport;
 };
type Result_1 = 
 variant {
   err: text;
   ok;
 };
type Result = 
 variant {
   err: TagError;
   ok;
 };
type ReportReason = 
 variant {
   Other;
   Outdated;
   Typo;
   Unclear;
   WrongAnswer;
 };
type QuizFilter = 
 record {
   articleIds: vec text;
   casebook: bool;
   count: nat;
   difficulty: opt Difficulty;
   sportId: text;
 };
type QuestionReport = 
 record {
   createdAt: int;
   id: text;
   note: text;
   questionId: text;
   reason: ReportReason;
   reporter: principal;
   resolution: text;
   resolved: bool;
   resolvedAt: opt int;
 };
type QuestionInput = 
 record {
   articleId: text;
   choices: vec Choice;
   citation: text;
   correctId: text;
   difficulty: Difficulty;
   explanation: text;
   isCasebook: bool;
   isPointOfEmphasis: bool;
   sportId: text;
   stem: text;
 };
type Question = 
 record {
   articleId: text;
   choices: vec Choice;
   citation: text;
   correctId: text;
   createdAt: int;
   difficulty: Difficulty;
   explanation: text;
   id: text;
   isCasebook: bool;
   isPointOfEmphasis: bool;
   sportId: text;
   stem: text;
 };
type ExamPick = 
 record {
   adaptive: bool;
   articleIds: vec text;
   casebook: bool;
   count: nat;
   difficulty: opt Difficulty;
   tag: opt text;
 };
type Difficulty = 
 variant {
   Advanced;
   Beginner;
   Expert;
   Intermediate;
 };
type Choice = 
 record {
   id: text;
   "text": text;
 };
service : {
  addQuestion: (input: QuestionInput) -> (Result_6);
  /// Called by the user canister when an official deletes their account:
  /// drops their spaced-repetition history and their question reports. The
  /// per-question answer totals stay: they are counts with no one's
  /// identity in them. Safe to repeat.
  forgetUser: (p: principal) -> (Result_1);
  getAdaptiveQuiz: (filter: QuizFilter) -> (vec Question) query;
  getAnswerRates: (questionIds: vec text) ->
   (vec record {
          text;
          nat;
          nat;
        }) query;
  getDueCount: (sportId: text, articleIds: vec text, casebook: bool) ->
   (nat) query;
  getMostMissedQuestions: (sportId: text, limit: nat) ->
   (vec record {
          text;
          nat;
          nat;
        }) query;
  /// The caller's (articleId, correct, answered) for every article of a
  /// sport they've answered, for the certification readiness score (#65).
  /// Pro once the paywall is on (#71).
  getMyArticleAccuracy: (sportId: text) -> (Result_5) composite_query;
  getMyHistoryBatch: (questionIds: vec text) ->
   (vec opt UserQuestionHistory) query;
  getMyWeakArticles: (sportId: text, limit: nat) ->
   (Result_5) composite_query;
  getQuestion: (id: text) -> (opt Question) query;
  getQuestionTags: (questionId: text) -> (vec text) query;
  isAdminCaller: () -> (bool) query;
  /// A sport's whole question bank, a page at a time in id order, for the
  /// app's offline cache (sampleQuiz capped it at 500 per type with no way
  /// to get the rest). Pass the previous page's `next` as `after`.
  listForSync: (sportId: text, after: opt text, limit: nat) ->
   (record {
      next: opt text;
      questions: vec Question;
    }) query;
  /// Admin queue. Open reports only, or every report when `includeResolved`.
  listQuestionReports: (includeResolved: bool) -> (Result_4) query;
  metrics: () -> (record {
                    openReports: nat;
                    questionCount: nat;
                  }) query;
  /// Questions the caller has an open report on, so the app can show
  /// "Reported" instead of the button.
  myOpenReports: (questionIds: vec text) -> (vec text) query;
  pickForExam: (sportId: text, picks: vec ExamPick, player: principal) ->
   (Result_3);
  questionsForExam: (ids: vec text) -> (Result_3);
  recordAnswer: (questionId: text, isCorrect: bool) -> ();
  /// Called by the exam canister when a quiz or exam finishes, with the
  /// player's graded answers: updates their spaced-repetition history and
  /// the per-question totals, as recordAnswer did from the browser. Safe to
  /// repeat.
  recordGradedAnswers: (player: principal, sessionId: text, answers:
   vec record {
         text;
         bool;
       }) -> (Result_1);
  reportQuestion: (questionId: text, reason: ReportReason, note: text) ->
   (Result_2);
  resolveQuestionReport: (id: text, resolution: text) -> (Result_2);
  sampleQuiz: (filter: QuizFilter) -> (vec Question) query;
  setAdmin: (p: principal) -> (Result_1);
  /// Replaces a question's tags (an empty list removes them). Admin only.
  setQuestionTags: (questionId: text, tags: vec text) -> (Result);
}
