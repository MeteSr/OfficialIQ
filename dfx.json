    },
    "exam": {
      "type": "motoko",
      "main": "backend/exam/main.mo"
    },
    "ranking": {
      "type": "motoko",
      "main": "backend/ranking/main.mo"
    },
    "challenge": {
      "type": "motoko",
      "main": "backend/challenge/main.mo"
    },
    "ai_proxy": {
      "type": "motoko",
      "main": "backend/ai_proxy/main.mo"
    },
    "mentorship": {
      "type": "motoko",
      "main": "backend/mentorship/main.mo"
    },
    "association": {
