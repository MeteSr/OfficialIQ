# Copy to /etc/officialiq-push-relay.env (outside the repo, root-only
# readable) and fill in real values. Never commit the filled-in version.
#
#   sudo install -m 600 -o root -g root /dev/null /etc/officialiq-push-relay.env
#   sudo $EDITOR /etc/officialiq-push-relay.env

# icp identity used to call the ranking/user canisters: the dedicated push
# relay identity (PUSH_RELAY_IDENTITY_PEM in docs/DEPLOYMENT.md), registered
# with `node frontend/scripts/admin.mjs ic set-push-relay <principal>`. Never
# the deploy key, which controls every canister. This env file approach assumes the
# identity has already been imported once via:
#   sudo -u officialiq icp identity import ci --from-pem /path/to/key.pem --storage plaintext
#   sudo -u officialiq icp identity default ci
# (systemd doesn't re-import it on every run the way the GitHub Actions
# workflow does, since the identity persists on disk between timer firings.)

VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
