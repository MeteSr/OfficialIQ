# Copy to /etc/officialiq-push-relay.env (outside the repo, root-only
# readable) and fill in real values. Never commit the filled-in version.
#
#   sudo install -m 600 -o root -g root /dev/null /etc/officialiq-push-relay.env
#   sudo $EDITOR /etc/officialiq-push-relay.env

# dfx identity used to call the ranking/user canisters — same PEM you'd use
# for scripts/import-identity.sh. This env file approach assumes the
# identity has already been imported once via:
#   sudo -u officialiq dfx identity import ci /path/to/key.pem --storage-mode plaintext
#   sudo -u officialiq dfx identity use ci
# (systemd doesn't re-import it on every run the way the GitHub Actions
# workflow does, since the identity persists on disk between timer firings.)

VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
