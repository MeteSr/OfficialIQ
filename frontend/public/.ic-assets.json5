// Asset-canister HTTP response config for production deploys (dfx copies
// this file straight through via Vite's `public/` passthrough, so it lands
// at frontend/dist/.ic-assets.json5 — the exact path dfx's assets canister
// looks for). See issue #33 / docs/DEPLOYMENT.md.
//
// Vite content-hashes everything under /assets/, so those files are safe to
// cache forever; index.html and the service worker must always be
// revalidated, or clients could get stuck on a stale build after a redeploy.
[
  {
    "match": "**/*",
    "headers": {
      "Cache-Control": "public, max-age=3600",
    },
  },
  {
    "match": "assets/**/*",
    "headers": {
      "Cache-Control": "public, max-age=31536000, immutable",
    },
  },
  {
    "match": "index.html",
    "headers": {
      "Cache-Control": "no-cache, must-revalidate",
    },
  },
  {
    "match": "sw.js",
    "headers": {
      "Cache-Control": "no-cache, must-revalidate",
    },
  },
  {
    "match": "manifest.webmanifest",
    "headers": {
      "Cache-Control": "public, max-age=3600",
    },
  },
]
