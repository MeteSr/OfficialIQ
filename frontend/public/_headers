# Response headers for the certified-assets canister (static-site skill).
# Replaces the legacy asset canister's .ic-assets.json5, which this canister
# does not read. Patterns match files, not URLs: /app.html covers every
# app route rewritten to it. Every matching block contributes (same-name
# values are joined), so each Cache-Control below targets disjoint files.

# Content-Security-Policy follows DFINITY's default for asset canisters
# (frontend security guidance): scripts only from this canister, agent calls
# only to IC boundary nodes (and the local network in development), Google
# Fonts for the typeface, no plugins, no framing. Internet Identity runs in a
# popup window, which CSP does not restrict. media-src allows https: because
# game clips play from Cloudflare Stream (signed customer-*.cloudflarestream.com
# links); blob: covers TTS audio played from canister bytes. connect-src
# allows upload.videodelivery.net, where clips are uploaded straight to
# Cloudflare.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self' http://localhost:* http://*.localhost:* https://icp0.io https://*.icp0.io https://ic0.app https://*.ic0.app https://icp-api.io https://upload.videodelivery.net; img-src 'self' data: blob:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Vite content-hashes everything under /assets/, so cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The pages and the service worker must always revalidate, or clients can
# get stuck on a stale build after a redeploy. index.html, privacy/ and terms/
# are prerendered pages; app.html is the app shell every app route is
# rewritten to (build-config/seo.ts writes _redirects), never a search result.
/index.html
  Cache-Control: no-cache, must-revalidate

/privacy/index.html
  Cache-Control: no-cache, must-revalidate

/terms/index.html
  Cache-Control: no-cache, must-revalidate

/app.html
  Cache-Control: no-cache, must-revalidate
  X-Robots-Tag: noindex

/sw.js
  Cache-Control: no-cache, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Native sign-in (src/lib/nativeAuth.ts, files built by build-config/wellKnown.ts).
# Internet Identity fetches ii-auth-callbacks from id.ai, so it needs CORS;
# the extensionless files need an explicit JSON content type.
/.well-known/ii-auth-callbacks
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/.well-known/apple-app-site-association
  Content-Type: application/json

/.well-known/assetlinks.json
  Content-Type: application/json
